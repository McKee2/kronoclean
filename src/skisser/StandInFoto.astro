---
/**
 * SYNTETISK STAND-IN. INTE ETT FOTO, OCH FÅR ALDRIG BLI ETT.
 *
 * Skisserna behöver något bakom sig för att gå att bedöma, och den enda
 * ärliga fyllningen är en som inte kan misstas för ett foto. Den här är
 * ritad i gradienter: den har ett fotos TONOMFÅNG (nära svart i vänstra
 * hörnet, nära vitt i fönstret) men inget fotos innehåll.
 *
 * Tonomfånget är hela poängen. Kontrastberäkningarna för skiss (a) antar
 * värsta fall — en helt svart och en helt vit pixel under skrimmet — och
 * den här ytan innehåller båda. Det som syns i skissen är alltså inte en
 * uppskattning utan just det fall talen är räknade för.
 *
 * Ligger i src/skisser/ och inte i src/components/ så att den inte kan
 * råka importeras in i sidan.
 */
interface Props {
  class?: string;
}
const { class: klass } = Astro.props;
---

<svg
  class={klass}
  viewBox="0 0 1200 600"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    {/* Rummet: mörkt vänster, ljust mot fönstret till höger */}
    <linearGradient id="standin-rum" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#0b0d10" />
      <stop offset="0.45" stop-color="#3d4148" />
      <stop offset="0.78" stop-color="#c9c5bd" />
      <stop offset="1" stop-color="#fdfdfb" />
    </linearGradient>
    {/* Fönsterljuset — den vita pixeln värstafallsberäkningen förutsätter */}
    <radialGradient id="standin-ljus" cx="0.82" cy="0.3" r="0.42">
      <stop offset="0" stop-color="#ffffff" stop-opacity="1" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
    {/* Golvskugga — den svarta pixeln */}
    <radialGradient id="standin-skugga" cx="0.12" cy="0.85" r="0.5">
      <stop offset="0" stop-color="#000000" stop-opacity="0.95" />
      <stop offset="1" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1200" height="600" fill="url(#standin-rum)" />
  <rect width="1200" height="600" fill="url(#standin-ljus)" />
  <rect width="1200" height="600" fill="url(#standin-skugga)" />

  {/* Två suddiga gestalter, ungefär där en familj skulle stå */}
  <g fill="#1a1d22" opacity="0.55">
    <ellipse cx="470" cy="330" rx="46" ry="52" />
    <path d="M380 600c0-98 40-160 90-160s90 62 90 160z" />
    <ellipse cx="640" cy="345" rx="40" ry="46" />
    <path d="M562 600c0-88 35-142 78-142s78 54 78 142z" />
  </g>

  {/* Etiketten är obligatorisk. En bild utan den kan hamna i en
      skärmdump och tas för ett riktigt foto. */}
  <text
    x="24"
    y="40"
    font-family="ui-monospace, monospace"
    font-size="22"
    fill="#ffffff"
    opacity="0.72">SYNTETISK STAND-IN — INTE ETT FOTO</text>
</svg>
