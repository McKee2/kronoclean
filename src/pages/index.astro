---
import '../styles/global.css';
import Hero from '../components/sections/Hero.astro';
import Tjanster from '../components/sections/Tjanster.astro';
import SaGarDetTill from '../components/sections/SaGarDetTill.astro';
import Kontakt from '../components/sections/Kontakt.astro';
import Sidfot from '../components/Sidfot.astro';
import {
  COMPANY,
  SEO,
  absoluteUrl,
  ogImageUrl,
  buildStructuredData,
  assertRedoForProduktion,
  skaNoindexas,
} from '../data/company';

// Vägrar bygga för produktion så länge något obekräftat fält skulle nå
// publik. No-op i dev. Undantaget för preview härleds ur CF_PAGES_BRANCH,
// inte ur en miljövariabel — se company.ts.
assertRedoForProduktion();

// noindex så länge platshållare kan förekomma. Env-oberoende backstopp:
// Cloudflares preview-deployer är publika som standard.
const noindex = skaNoindexas();

// Astro.site kommer från astro.config.mjs, Astro.url är den aktuella sidan.
// Hårdkoda aldrig domänen här — den finns redan på ett ställe.
const canonical = absoluteUrl(Astro.site, Astro.url.pathname);
const ogImage = ogImageUrl(Astro.site);
const structuredData = buildStructuredData(Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Så länge någon uppgift är obekräftad får sidan inte indexeras.
        Beror inte på miljövariabler och överlever därför felkonfiguration.
        Försvinner av sig själv när alla flaggor är vända. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{SEO.title}</title>
    <meta name="description" content={SEO.description} />
    <link rel="canonical" href={canonical} />

    {/* TODO: byt ut båda — de är Astros standardmärke, inte Kronocleans */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* apple-touch-icon länkas först när filen finns. En 404 i <head>
        är samma sorts osanning som en platshållartelefon. */}
    <meta name="theme-color" content={SEO.themeColor} />

    {/* De fyra obligatoriska enligt ogp.me: type, title, url, image */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={SEO.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* Rekommenderade */}
    <meta property="og:image:alt" content={SEO.ogImageAlt} />
    <meta property="og:description" content={SEO.description} />
    <meta property="og:site_name" content={COMPANY.name} />
    <meta property="og:locale" content={SEO.locale} />

    {/* X/Twitter läser OG för titel, text och bild — bara korttypen behövs.
        OBS: att X faller tillbaka på OG är OVERIFIERAT i genomgången. */}
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      set:html behövs av två skäl:
      1) Astro behandlar <script>-innehåll som JavaScript att bundla, och
         {}-interpolation i ett raw-text-element är inte pålitligt.
      2) Astro escapar {uttryck}; ett escape:at " blir &quot; och JSON:en
         slutar parsa.
      Säkert här: indata är JSON.stringify av modullokala konstanter.
      Ingen användarinmatning, inget CMS, statiskt bygge.
      Blir datan någonsin dynamisk måste < härdas — JSON.stringify escapar
      inte <, och en sträng som innehåller </script> avslutar elementet:
        .replace(/</g, '\\u003c')
    */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    {/*
      SEKTIONSRYTMEN. Fyra block, tre ytbyten, åtta sektioner när sidan
      är färdig. Ytan byts när LÄSARENS UPPGIFT byts, inte varannan
      sektion — ren växling ljus/mörk läser som ränder och betyder
      ingenting.

        yta-mist   Hero · Tjänster                        orienterar sig
        yta-vit    Så går det till · Priser               kontrollerar affären
        yta-mist   Områden · Vanliga frågor · Kontakt     slår upp, hör av sig
        yta-navy   Footer                                 avslutar

      Kontakt låg först i det mörka blocket. Den flyttades till block 3
      när 660 px sammanhängande mörkt visade sig läsa som en annan sajt
      snarare än som ett avslut. Den hamnade rätt på köpet: block 3 är
      uppslagsmaterial, och att höra av sig hör dit — det är vad man gör
      när man slagit upp det man behövde veta.

      Två sektioner i samma yta skiljs av LUFT, inte av en linje: varje
      sektion har py-20/lg:py-28, alltså 160 px på mobil och 224 px på
      desktop mellan innehållen, och var och en inleds med sin egen h2.
      Linjen är reserverad för gruppering INUTI en sektion — så som
      Tjänster skiljer privat från företag. Tre nivåer, tre medel, ingen
      överlappning: ytbyte skiljer block, luft skiljer sektioner, linje
      grupperar inuti en sektion.
    */}
    <main>
      <Hero />
      <Tjanster />
      <SaGarDetTill segment="privat" />
      <Kontakt />
    </main>
    {/* <footer> hör inte hemma i <main> — den är sidmetadata, inte
        sidans innehåll. Ytan är densamma som Kontakts, så det mörka
        blocket löper obrutet till sidans slut trots att gränsen för
        <main> går emellan. */}
    <Sidfot />
  </body>
</html>
