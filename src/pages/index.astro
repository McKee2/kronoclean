---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Hero from '../components/sections/Hero.astro';
import Tjanster from '../components/sections/Tjanster.astro';
import SaGarDetTill from '../components/sections/SaGarDetTill.astro';
import Kontakt from '../components/sections/Kontakt.astro';
import Sidhuvud from '../components/Sidhuvud.astro';
import Sidfot from '../components/Sidfot.astro';
import {
  COMPANY,
  SEO,
  absoluteUrl,
  ogImageUrl,
  buildStructuredData,
  assertRedoForProduktion,
  skaNoindexas,
} from '../data/company';

// Vägrar bygga för produktion så länge något obekräftat fält skulle nå
// publik. No-op i dev. Undantaget för preview härleds ur CF_PAGES_BRANCH,
// inte ur en miljövariabel — se company.ts.
assertRedoForProduktion();

// noindex så länge platshållare kan förekomma. Env-oberoende backstopp:
// Cloudflares preview-deployer är publika som standard.
const noindex = skaNoindexas();

// Astro.site kommer från astro.config.mjs, Astro.url är den aktuella sidan.
// Hårdkoda aldrig domänen här — den finns redan på ett ställe.
const canonical = absoluteUrl(Astro.site, Astro.url.pathname);
const ogImage = ogImageUrl(Astro.site);
const structuredData = buildStructuredData(Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      TYPSNITTEN. Utan de här två raderna emitteras inga @font-face alls
      — deklarationen i astro.config.mjs räcker inte, den beskriver bara
      vad som SKA laddas. Verifierat i dist före rättelsen: noll
      @font-face, noll preload, sidan renderad i Georgia och Segoe UI.

      Står först i <head> för att preload-länkarna ska hinna först.

      preload är filtrerad, inte true. true preloadar varje fil familjen
      har; här preloadas bara de skärningar som faktiskt syns över
      vikningen: serifens 400 (h1 och telefonnumret) och sansens 400
      (brödtext). Sansens 600 används bara till taglinen, sidfotens
      etiketter, stegsiffrorna och numret i sidhuvudet, och hämtas i
      vanlig ordning.
    */}
    <Font cssVariable="--font-instrument-serif" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-fira-sans" preload={[{ weight: 400 }]} />

    {/* Så länge någon uppgift är obekräftad får sidan inte indexeras.
        Beror inte på miljövariabler och överlever därför felkonfiguration.
        Försvinner av sig själv när alla flaggor är vända. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{SEO.title}</title>
    <meta name="description" content={SEO.description} />
    <link rel="canonical" href={canonical} />

    {/* TODO: byt ut båda — de är Astros standardmärke, inte Kronocleans */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* apple-touch-icon länkas först när filen finns. En 404 i <head>
        är samma sorts osanning som en platshållartelefon. */}
    <meta name="theme-color" content={SEO.themeColor} />

    {/* De fyra obligatoriska enligt ogp.me: type, title, url, image */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={SEO.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* Rekommenderade */}
    <meta property="og:image:alt" content={SEO.ogImageAlt} />
    <meta property="og:description" content={SEO.description} />
    <meta property="og:site_name" content={COMPANY.name} />
    <meta property="og:locale" content={SEO.locale} />

    {/* X/Twitter läser OG för titel, text och bild — bara korttypen behövs.
        OBS: att X faller tillbaka på OG är OVERIFIERAT i genomgången. */}
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      set:html behövs av två skäl:
      1) Astro behandlar <script>-innehåll som JavaScript att bundla, och
         {}-interpolation i ett raw-text-element är inte pålitligt.
      2) Astro escapar {uttryck}; ett escape:at " blir &quot; och JSON:en
         slutar parsa.
      Säkert här: indata är JSON.stringify av modullokala konstanter.
      Ingen användarinmatning, inget CMS, statiskt bygge.
      Blir datan någonsin dynamisk måste < härdas — JSON.stringify escapar
      inte <, och en sträng som innehåller </script> avslutar elementet:
        .replace(/</g, '\\u003c')
    */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    {/*
      SEKTIONSRYTMEN. Sidan har TVÅ ytor och en accent. Ingen mörk yta
      finns — leta inte efter en.

        yta-mist   Hero · Tjänster · Kontakt · Sidfot
        yta-vit    Så går det till

      mist · mist · vit · mist · mist. Ett enda avbrott mitt på sidan.
      Två vita block bland fem sektioner börjar alternera, och
      alternering är vad som läser som ränder. Det vita blocket är
      "Så går det till" — den tätaste och mest lästa sektionen, den som
      tar bort osäkerhet — så det är rätt sektion att lyfta. En sidfot
      är aldrig en emfas och hör hemma på grundytan.

      SEPARATION, tre medel och en regel: EN LINJE MARKERAR EN GRÄNS
      SOM YTBYTET INTE GÖR.

        Hero -> Tjänster        mist->mist  förtroendemarkörernas egen
                                            linje avslutar redan heron
        Tjänster -> Så går...   mist->vit   ytbytet
        Så går... -> Kontakt    vit->mist   ytbytet
        Kontakt -> Sidfot       mist->mist  LINJEN, 2 px i Sidfot.astro

      En linje på hela sidan, inte en per sektion. Fler läser som ett
      formulär, och regeln håller antalet nere av sig själv när
      sektioner tillkommer.

      Linjenivåerna får inte blandas ihop: pa-*-linje (1.30) grupperar
      INUTI en sektion, pa-*-avdelare (2.01) markerar en gräns MELLAN
      sektioner. Att i stället höja linje-* provades och förkastades —
      då följer varje grupperingslinje med upp och konkurrerar med
      sektionsgränsen.
    */}
    {/*
      SIDHUVUDET ligger utanför <main> av samma skäl som <footer> gör:
      det är sidmetadata, inte sidans innehåll. Landmärkena blir därmed
      header / main / footer, i den ordningen och utan nästling.

      Det är sticky och därför INTE en fjärde sektion i rytmen ovan — det
      har ingen egen plats i mist · mist · vit · mist · mist utan rullar
      över alla fem. Ytan är mist just för att det ska vara sant: vid
      rullning 0 är baren samma yta som heron under den.
    */}
    <Sidhuvud />
    <main>
      <Hero />
      <Tjanster />
      <SaGarDetTill segment="privat" />
      <Kontakt />
    </main>
    {/* <footer> hör inte hemma i <main> — den är sidmetadata, inte
        sidans innehåll. Ytan är densamma som Kontakts (mist, som allt
        utom ett block), så ytan löper obrutet till sidans slut trots
        att gränsen för <main> går emellan; gränsen bärs i stället av
        2 px-linjen inuti Sidfot.astro. Meningen talade tidigare om
        "det mörka blocket" — det försvann 2026-09-02 och kommentaren
        blev kvar. */}
    <Sidfot />
  </body>
</html>
