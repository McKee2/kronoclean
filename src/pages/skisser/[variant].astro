---
import HeroSkissA from '../../skisser/HeroSkissA.astro';
import HeroSkissB from '../../skisser/HeroSkissB.astro';
import Tjanster from '../../components/sections/Tjanster.astro';

/**
 * SKISSRUTTEN — FINNS BARA I DEV, OCH DET ÄR MEKANISKT.
 *
 * getStaticPaths returnerar [] i produktionsbygget. Astro genererar då
 * inga sidor, sitemapen får inga rader och dist/skisser existerar inte.
 * Spärren är alltså inte "kom ihåg att ta bort skisserna före lansering"
 * utan samma sorts konstruktion som resten av projektet: det går inte att
 * göra fel av misstag. Verifieras i stagingbygget genom att räkna filer
 * under dist/skisser.
 *
 * Skisskomponenterna bor i src/skisser/, inte i src/components/, så att
 * ingen kan råka importera en skiss in i den riktiga sidan.
 *
 * Sidan renderar skissens hero PLUS den riktiga tjänstesektionen. Utan
 * den går inte gränsen hero -> Tjänster att bedöma, och det är den (b)
 * ändrar mest.
 *
 * TRE LÄCKOR TÄTADE, ALLA TRE MÄTTA I DIST:
 *
 *   1. HTML. getStaticPaths ovan. 0 filer under dist/skisser.
 *   2. UTILITIES. Tailwind läser källfiler, inte sidor. src/skisser/ gav
 *      sex regler i sidans stilmall (.text-pa-navy-*, .-z-10) trots att
 *      rutten byggde noll sidor. Tätad med @source not i global.css, se
 *      src/styles/skisser.css.
 *   3. STILMALLEN SJÄLV. En vanlig toppimport av skisser.css bundlas av
 *      Vite även när rutten bygger noll sidor: en föräldralös CSS-fil på
 *      16 972 byte i dist/_astro/ som ingen HTML refererar till. Därför
 *      den dynamiska importen nedan — import.meta.env.DEV är
 *      kompiletidskonstant, så grenen och filen försvinner ur bygget.
 *
 * Nettot på sidans egen CSS: 19 562 byte före, 18 922 + 641 inline efter.
 * Skillnad 1 byte, och den byten är att Astro flyttade tjänstekortens
 * scoped styles från den externa filen till en <style> i HTML:en när
 * skissrutten slutade dela chunk med index.
 */
if (import.meta.env.DEV) {
  await import('../../styles/skisser.css');
}

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [
    { params: { variant: 'a' } },
    { params: { variant: 'b' } },
    { params: { variant: 'b-foto' } },
  ];
}

const { variant } = Astro.params;

const TITLAR: Record<string, string> = {
  a: 'Skiss (a) — foto bakom heron',
  b: 'Skiss (b) — band under texten, platshållare',
  'b-foto': 'Skiss (b) — band under texten, stand-in i bandet',
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Bältesspänne på hängslena. Sidan byggs aldrig, men om den ändå
        gjorde det ska den inte indexeras. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{TITLAR[variant!] ?? 'Skiss'}</title>
  </head>
  <body>
    <main>
      {variant === 'a' && <HeroSkissA />}
      {variant === 'b' && <HeroSkissB />}
      {variant === 'b-foto' && <HeroSkissB medFoto />}
      <Tjanster />
    </main>
  </body>
</html>
