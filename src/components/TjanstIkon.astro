---
/**
 * Tjänsteikonerna. Ritade för hand, inget ikonbibliotek.
 *
 * Alla fem delar exakt samma ritregler, och det är därför de ser ut att
 * komma från samma hand:
 *
 *   - 24x24-ruta, motivet inom 3..21 så strecket aldrig klipps av kanten
 *   - fill="none", stroke="currentColor", stroke-width 1.5
 *   - runda ändar och hörn, inga fyllda ytor, inga två streckbredder
 *   - raka linjer där det går, radie 1–1.5 där något måste rundas
 *
 * Samma regler som bocken i heron, bara i en större ruta. Bocken har
 * stroke-width 2.5 för att den renderas i 16 px — vid 28 px skulle den
 * bli klumpig, så den här komponenten står på 1.5.
 *
 * Bara `d`-strängar, inga <circle>/<rect>: en enda elementtyp gör att alla
 * fem ikoner går att läsa bredvid varandra i listan nedan och att en
 * avvikelse i formspråket syns direkt i diffen.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: klass } = Astro.props;

const IKONER: Record<string, string[]> = {
  // Hus: taklinje, kropp, dörr.
  hemstadning: [
    'M3 10.5 12 3.5l9 7',
    'M5.5 9.8V20.5h13V9.8',
    'M10 20.5v-5.5h4v5.5',
  ],

  // Flyttkartong: kropp, uppfällda lock, tejpremsa.
  flyttstadning: [
    'M4 8.5h16v10.6a1.4 1.4 0 0 1-1.4 1.4H5.4A1.4 1.4 0 0 1 4 19.1z',
    'M4 8.5 6 3.9h12l2 4.6',
    'M9.5 12.6h5',
  ],

  /**
   * Nyckel: ring, skaft, två ax. Medvetet neutral.
   * Dödsbostädning handlar om att lämna över en bostad. Allt som pekar
   * mot begravning — ljus, kors, blommor — vore att göra ett övergrepp på
   * någon som redan har det svårt. En nyckel säger överlämning och inget
   * mer, och den bär samma ton som texten kommer att göra.
   */
  dodsbostadning: [
    'M12.2 15.8a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
    'M11 13 19.5 4.5',
    'M17 7l2 2',
    'M14.6 9.4l2 2',
  ],

  // Kontorshus: huvudkropp, lägre flygel, marklinje, fönsterrader.
  kontorsstadning: [
    'M4.5 20.5V4.9a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v15.6',
    'M14.5 11h4a1 1 0 0 1 1 1v8.5',
    'M3 20.5h18',
    'M7.5 8h3M7.5 12h3M7.5 16h3',
  ],

  // Säng: gavel, madrass, lakanslinje, kudde.
  hotellstadning: [
    'M3.5 20V9.5',
    'M3.5 13h15.6a2 2 0 0 1 2 2V20',
    'M3.5 16.6h17.6',
    'M7 13v-1.4a1.5 1.5 0 0 1 1.5-1.5h3.2a1.5 1.5 0 0 1 1.5 1.5V13',
  ],
};

const paths = IKONER[slug];

/**
 * Smäller av vid bygget i stället för att rendera en tom ruta. Samma
 * princip som resten av projektet: en tjänst utan ikon är ett ofärdigt
 * tillstånd, och ett ofärdigt tillstånd ska synas som ett stopp, inte
 * som ett hål i rutnätet.
 */
if (!paths) {
  throw new Error(
    `TjanstIkon: ingen ikon ritad för "${slug}".\n` +
      'Rita en i IKONER i src/components/TjanstIkon.astro, eller ta bort\n' +
      'tjänsten ur SERVICES i src/data/company.ts.',
  );
}
---

<svg
  class={klass}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths.map((d) => <path d={d} />)}
</svg>
