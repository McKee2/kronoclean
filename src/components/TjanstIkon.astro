---
/**
 * Tjänsteikonerna. Ritade för hand, inget ikonbibliotek.
 *
 * Alla fem delar exakt samma ritregler, och det är därför de ser ut att
 * komma från samma hand:
 *
 *   - 24x24-ruta, motivet inom 3..21 så strecket aldrig klipps av kanten
 *   - fill="none", stroke="currentColor", stroke-width 1.5
 *   - runda ändar och hörn, inga fyllda ytor, inga två streckbredder
 *   - raka linjer där det går, radie 1–1.5 där något måste rundas
 *   - BLÄCKETS MITT PÅ 12 ± 0.25 I HÖJDLED. Sjätte regeln, tillagd när
 *     ikonen flyttade upp bredvid rubriken. Se nedan.
 *
 * ==================================================================
 * SJÄTTE REGELN, OCH VARFÖR DEN INTE BEHÖVDES FÖRRÄN NU
 * ==================================================================
 * "Motivet inom 3..21" säger var strecket får finnas, inte var det ska
 * ligga. Så länge ikonen stod ENSAM ovanför rubriken syntes inte
 * skillnaden: en ikon som är ritad lågt i sin ruta ser bara ut att ha
 * lite mer luft över sig.
 *
 * Bredvid en rubrik syns den direkt. Rutan centreras mot rubrikens
 * versalmitt, och står bläcket lågt i rutan hamnar ikonen lågt mot
 * texten — CSS kan inte rätta det, för CSS ser rutan och inte bläcket.
 *
 * Uppmätt med getBBox i webbläsaren, bläckets mitt i höjdled:
 *
 *   hemstadning      3.5 .. 20.5   mitt 12.00
 *   flyttstadning    3.9 .. 20.5   mitt 12.20
 *   dodsbostadning   4.5 .. 19.8   mitt 12.15
 *   kontorsstadning  3.9 .. 20.5   mitt 12.20
 *   hotellstadning   9.5 .. 20.0   mitt 14.75   <- 2.75 fel, omritad
 *
 * Fyra av fem följde regeln redan innan den fanns. Sängen gjorde inte
 * det, och den var dessutom bara 10.5 enheter hög mot de andras 15-17:
 * både låg OCH liten. Omritad nedan med hög gavel, mitt 12.25 och höjd
 * 16.5. Marklinjen ligger kvar på 20.5, samma som husets och kontorets,
 * så ikonerna fortfarande står på samma golv när de ses bredvid varandra
 * i rutnätet.
 *
 * Samma regler som bocken i heron, bara i en större ruta. Bocken har
 * stroke-width 2.5 för att den renderas i 16 px — vid 28 px skulle den
 * bli klumpig, så den här komponenten står på 1.5.
 *
 * Bara `d`-strängar, inga <circle>/<rect>: en enda elementtyp gör att alla
 * fem ikoner går att läsa bredvid varandra i listan nedan och att en
 * avvikelse i formspråket syns direkt i diffen.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: klass } = Astro.props;

const IKONER: Record<string, string[]> = {
  // Hus: taklinje, kropp, dörr.
  hemstadning: [
    'M3 10.5 12 3.5l9 7',
    'M5.5 9.8V20.5h13V9.8',
    'M10 20.5v-5.5h4v5.5',
  ],

  // Flyttkartong: kropp, uppfällda lock, tejpremsa.
  flyttstadning: [
    'M4 8.5h16v10.6a1.4 1.4 0 0 1-1.4 1.4H5.4A1.4 1.4 0 0 1 4 19.1z',
    'M4 8.5 6 3.9h12l2 4.6',
    'M9.5 12.6h5',
  ],

  /**
   * Nyckel: ring, skaft, två ax. Medvetet neutral.
   * Dödsbostädning handlar om att lämna över en bostad. Allt som pekar
   * mot begravning — ljus, kors, blommor — vore att göra ett övergrepp på
   * någon som redan har det svårt. En nyckel säger överlämning och inget
   * mer, och den bär samma ton som texten kommer att göra.
   */
  dodsbostadning: [
    'M12.2 15.8a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
    'M11 13 19.5 4.5',
    'M17 7l2 2',
    'M14.6 9.4l2 2',
  ],

  // Kontorshus: huvudkropp, lägre flygel, marklinje, fönsterrader.
  kontorsstadning: [
    'M4.5 20.5V4.9a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v15.6',
    'M14.5 11h4a1 1 0 0 1 1 1v8.5',
    'M3 20.5h18',
    'M7.5 8h3M7.5 12h3M7.5 16h3',
  ],

  /**
   * Säng: hög gavel, madrass med fotgavel, sarglinje, kudde.
   *
   * Gaveln är hög med flit. Den förra sängen var ritad som en riktig säng
   * är byggd — låg — och blev därmed 10.5 enheter hög i en 24-ruta med
   * bläckmitten på 14.75. Bredvid en rubrik läste den både som lägre och
   * som mindre än de fyra andra. En hotellgavel som går upp till 4 ger
   * samma vertikala massa som huset och kontoret, och 16.5 enheters höjd
   * med mitten på 12.25.
   */
  hotellstadning: [
    'M4 20.5V5.4a1.4 1.4 0 0 1 1.4-1.4h3.2A1.4 1.4 0 0 1 10 5.4v7.2',
    'M10 12.6h8.6a2 2 0 0 1 2 2v5.9',
    'M4 16.4h16.6',
    'M11.6 12.6v-1.2a1.2 1.2 0 0 1 1.2-1.2h2.4a1.2 1.2 0 0 1 1.2 1.2v1.2',
  ],
};

const paths = IKONER[slug];

/**
 * Smäller av vid bygget i stället för att rendera en tom ruta. Samma
 * princip som resten av projektet: en tjänst utan ikon är ett ofärdigt
 * tillstånd, och ett ofärdigt tillstånd ska synas som ett stopp, inte
 * som ett hål i rutnätet.
 */
if (!paths) {
  throw new Error(
    `TjanstIkon: ingen ikon ritad för "${slug}".\n` +
      'Rita en i IKONER i src/components/TjanstIkon.astro, eller ta bort\n' +
      'tjänsten ur SERVICES i src/data/company.ts.',
  );
}
---

<svg
  class={klass}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths.map((d) => <path d={d} />)}
</svg>
