---
import { telefonVy, responsePromise, emailAdress } from '../../data/company';

const telefon = telefonVy();
const svarstid = responsePromise();
const mejl = emailAdress();
---

{/*
  KONTAKT — första sektionen i avslutningsblocket, och den första
  renderade användningen av yta-navy.

  Telefonen är PRIMÄR, inte en av flera vägar. Det syns i tre val:
  numret står i display-snittet i samma storlek som heron, mejlen står
  i brödtextstorlek under en avdelare, och det finns inget formulär.
  Ett formulär hade konkurrerat om samma klick och gjort ett val av
  något kunden redan bestämt.

  Alla färger kommer ur pa-navy-*. Inget här kunde lånas från de ljusa
  ytorna: pa-mist-brod ger 1.9 mot navy och pa-mist-accent-liten 1.4.
*/}
<section
  class="yta-navy pt-20 pb-20 lg:pt-28 lg:pb-28"
  aria-labelledby="kontakt-rubrik"
>
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <h2
      id="kontakt-rubrik"
      class="font-display text-3xl text-pa-navy-rubrik sm:text-4xl"
    >
      Hör av dig
    </h2>

    {/*
      Svarstidsraden renderas bara om löftet är bekräftat. Den är inte
      platshållarbar av samma skäl som står i rapporten: X:en i
      07X-XXX XX XX gör numret omöjligt att slå, men det finns ingen
      motsvarighet för en mening. "Vi svarar oftast inom X" är fortfarande
      ett löfte, bara ett vagt.
    */}
    {
      svarstid && (
        <p class="mt-3 max-w-xl font-sans text-base text-pa-navy-brod">
          {svarstid}
        </p>
      )
    }

    {
      telefon.lage !== 'dolt' && (
        <div class="mt-10">
          <p class="mb-2 font-sans text-sm text-pa-navy-brod">
            {telefon.lage === 'bekraftat'
              ? 'Ring så bokar vi en tid'
              : 'Numret läggs in innan sidan går live'}
          </p>

          {/*
            Samma tre lägen som i heron, och samma skäl. href finns bara
            på bekraftat-varianten, så platshållaren kan inte råka bli en
            länk här heller.
          */}
          {telefon.lage === 'bekraftat' ? (
            <a
              href={telefon.href}
              aria-label={`Ring ${telefon.text}`}
              class="telefon-lank inline-block py-1"
            >
              <span class="font-display text-4xl text-pa-navy-rubrik sm:text-5xl">
                {telefon.text}
              </span>
            </a>
          ) : (
            <p class="py-1 font-display text-4xl text-pa-navy-rubrik sm:text-5xl">
              {telefon.text}
            </p>
          )}
        </div>
      )
    }

    {
      mejl && (
        <div class="mt-10 border-t border-pa-navy-linje pt-6">
          <p class="font-sans text-sm text-pa-navy-brod">
            Ringer du ogärna går det lika bra att mejla.
          </p>
          <a
            href={`mailto:${mejl}`}
            class="mejl-lank mt-1 inline-block font-sans text-base text-pa-navy-accent-liten"
          >
            {mejl}
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  /*
    Understrykningen ritas ut vid hover, som i heron — men i vitt, för
    att pa-navy-accent på ett vitt telefonnummer hade varit en färg som
    inte syns mot texten den ligger under.
  */
  .telefon-lank {
    position: relative;
  }

  .telefon-lank::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    width: 100%;
    background: var(--color-pa-navy-rubrik);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .telefon-lank:hover::after,
  .telefon-lank:focus-visible::after {
    transform: scaleX(1);
  }

  /*
    Mejllänken är understruken från början. Den ligger i brödtextstorlek
    på mörk botten, och där räcker inte färg ensamt för att markera en
    länk — WCAG 1.4.1 kräver att information inte bärs av färg allena.
    Telefonnumret ovan är undantaget: det är 36–48 px i ett annat snitt
    och kan inte förväxlas med brödtext.
  */
  .mejl-lank {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .mejl-lank:hover {
    color: var(--color-pa-navy-rubrik);
  }

  @media (prefers-reduced-motion: reduce) {
    .telefon-lank::after {
      transition: none;
    }
  }
</style>
