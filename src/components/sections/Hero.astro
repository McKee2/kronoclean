---
import { COMPANY, trustMarkers } from '../../data/company';

const markers = trustMarkers();
---

<section class="pt-10 pb-20 lg:pt-14 lg:pb-28" aria-labelledby="hero-rubrik">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    {/* Logotyp. Byt till .png om SVG saknas. */}
    <div class="reveal [--delay:0s] mb-14 lg:mb-20">
      <img
        src="/nordclean-logo.webp"
        alt={COMPANY.name}
        width="1536"
        height="1024"
        fetchpriority="high"
        decoding="async"
        class="h-24 w-auto lg:h-32"
      />
    </div>

    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-14">
      {/* Vänster: budskap och kontakt */}
      <div class="lg:col-span-7">
        <p
          class="reveal [--delay:0.05s] mb-5 font-sans text-xs font-semibold uppercase tracking-[0.22em] text-sky-text"
        >
          {COMPANY.tagline}
        </p>

        <h1
          id="hero-rubrik"
          class="reveal [--delay:0.12s] font-display text-4xl leading-[1.08] text-navy sm:text-5xl lg:text-6xl"
        >
          Hemstädning i {COMPANY.city}.
        </h1>

        {/*
          Alternativ H1 med differentieringen inbakad. Byt in om ni hellre
          vill leda med den — men den kräver fyra rader på desktop.
          OBS: ta bort h1:an ovan om denna byts in, annars får sidan två h1.

          <h1 id="hero-rubrik" class="...">
            Hemstädning i {COMPANY.city}.<br />
            <span class="text-sky">Alltid samma person.</span>
          </h1>
        */}

        <p
          class="reveal [--delay:0.2s] mt-6 max-w-lg text-lg leading-relaxed text-slate"
        >
          Jag heter {COMPANY.ownerFirstName} och driver {COMPANY.name}. Du får
          samma städning av samma person varje gång — ingen roterande personal,
          inga främmande ansikten i hallen.
        </p>

        {/* Signaturelementet: numret som skylt, inte som knapp */}
        <div class="reveal [--delay:0.28s] mt-10">
          <p class="mb-2 font-sans text-sm text-slate">
            Ring så bokar vi en tid
          </p>
          <a
            href={COMPANY.phoneHref}
            aria-label={`Ring ${COMPANY.phone}`}
            class="phone-link group inline-block py-1"
          >
            <span
              class="font-display text-4xl text-navy transition-colors group-hover:text-sky group-focus-visible:text-sky sm:text-5xl"
            >
              {COMPANY.phone}
            </span>
          </a>
          <p class="mt-3 font-sans text-sm text-slate">
            {COMPANY.responsePromise}
          </p>
        </div>

        {/* Förtroendemarkörer — byggs från datafilen, aldrig hårdkodade */}
        <ul
          class="reveal [--delay:0.36s] mt-12 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-line pt-6"
        >
          {
            markers.map((marker) => (
              <li class="flex items-center gap-2 font-sans text-sm text-slate">
                <svg
                  class="h-4 w-4 shrink-0 text-sky"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M5 12l5 5L20 7"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {marker}
              </li>
            ))
          }
        </ul>
      </div>

      {/* Höger: porträttyta. Vitt kort som lyfter ur mist-bakgrunden. */}
      <div class="reveal [--delay:0.44s] lg:col-span-5">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-line bg-white shadow-[0_1px_3px_rgba(22,56,92,0.04),0_12px_32px_-12px_rgba(22,56,92,0.12)]"
        >
          {/* TODO: ersätt hela detta block med <img> när fotot finns */}
          <div
            class="absolute inset-0 flex flex-col items-center justify-center px-8 text-center"
          >
            <svg
              class="mb-4 h-10 w-10 text-sky-wash"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle cx="12" cy="9" r="3.5" stroke="currentColor" stroke-width="1.5" />
              <path
                d="M4.5 20a7.5 7.5 0 0 1 15 0"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
            <p class="font-sans text-sm text-slate">
              Foto på {COMPANY.ownerFirstName} kommer här
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Understrykning som ritas ut vid hover — hero-sidans signatur */
  .phone-link {
    position: relative;
  }

  /* -2px, inte -6px: länken har py-1 (4px) för att nå 44px träffyta,
     så underkanten ligger 4px längre ned än förut. */
  .phone-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    width: 100%;
    background: var(--color-sky);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .phone-link:hover::after,
  .phone-link:focus-visible::after {
    transform: scaleX(1);
  }

  /* Staplad intoning vid sidladdning.
     Fördröjningen kommer från Tailwinds arbitrary property [--delay:Xs],
     som blir en riktig CSS-regel i stilmallen — aldrig ett inline
     style-attribut. Inline style-attribut kräver unsafe-hashes i en CSP
     med style-src self, till skillnad från stilmallen. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 0s)
      forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .phone-link::after {
      transition: none;
    }
  }
</style>
